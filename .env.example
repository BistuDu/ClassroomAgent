# Current deployment: complete independent groups. Never put keys in frontend files.
CREATION_PROVIDER=deepseek
CREATION_BASE_URL=https://api.deepseek.com
CREATION_MODEL=deepseek-flash
CREATION_API=openai-completions
CREATION_API_KEY=
CREATION_CONTEXT_WINDOW=300000
CREATION_MAX_TOKENS=65536
# Compact above ~230000 tokens; reserve output room and keep ~20000 recent tokens.
CREATION_COMPACTION_ENABLED=true
CREATION_COMPACTION_RESERVE_TOKENS=70000
CREATION_COMPACTION_KEEP_RECENT_TOKENS=20000
# Enable only for a provider/model that supports reasoning. Responses summaries require Responses API.
CREATION_THINKING_LEVEL=off
GENERATION_MAX_TOKENS=65536
SIMULATION_MAX_TOKENS=65536
IMAGE_PROVIDER=gateway
IMAGE_BASE_URL=https://8yes.cc/v1
IMAGE_MODEL=gpt-image-2.5
IMAGE_API_KEY=
# Provider output size is independent of the 1280x720 course canvas.
IMAGE_OUTPUT_SIZE=auto
# Exact confirmed HTTPS download hosts only. Empty keeps strict public-IP checks.
IMAGE_MEDIA_HOSTS=
TAVILY_API_KEY=
BAILIAN_API_KEY=
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com
BAILIAN_TTS_MODEL=qwen3-tts-flash
BAILIAN_TTS_VOICE=Cherry
OPENMAIC_PORT=8001
OPENMAIC_ORIGIN=http://127.0.0.1:8001
MAX_TOOL_CALLS=120
RUN_TIMEOUT_SECONDS=1800
PROVIDER_TIMEOUT_SECONDS=180
MAX_REPAIR_ROUNDS=2
# Live classroom defaults to the resolved CREATION service as a whole.
# To override, provide ALL five fields (no credential mixing):
# CLASSROOM_PROVIDER=deepseek
# CLASSROOM_BASE_URL=https://api.deepseek.com
# CLASSROOM_MODEL=deepseek-flash
# CLASSROOM_API=openai-completions
# CLASSROOM_API_KEY=
# No fixed speaker-turn cap; director decides wait/end from the conversation.
CLASSROOM_MAX_TOOL_CALLS=8
CLASSROOM_MAX_TOKENS=4096
CLASSROOM_CONTEXT_TOKENS=24000
CLASSROOM_PROVIDER_TIMEOUT_SECONDS=90
CLASSROOM_GENERATION_TIMEOUT_SECONDS=180
CLASSROOM_ACK_TIMEOUT_SECONDS=45
# Legacy deployment only: remove the ENTIRE CREATION_* / IMAGE_* group to use these.
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-flash
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# BAILIAN_IMAGE_MODEL=wan2.6-t2i
